#!/usr/bin/env bash
set -euo pipefail

# Run a command with the secrets from ~/env/sensitive.sh in its environment,
# or list their names:
#
#   with-secrets <cmd> [args...]           every secret
#   with-secrets -o A,B <cmd> [args...]    only A and B
#   with-secrets -l                        the names alone

file="$HOME/env/sensitive.sh"

usage() {
    echo "usage: with-secrets [-o NAME[,NAME...]] <cmd> [args...]" >&2
    echo "       with-secrets -l" >&2
    exit 2
}

names=()
case "${1:-}" in
    -l)
        [[ $# -eq 1 ]] || usage
        # Print the NAME of each `export NAME=value` line.
        sed -nE 's/^export ([A-Za-z_][A-Za-z0-9_]*)=.*/\1/p' "$file"
        exit
        ;;
    -o)
        [[ $# -ge 2 && -n "$2" ]] || usage
        IFS=, read -ra names <<< "$2"
        shift 2
        ;;
esac
[[ $# -gt 0 ]] || usage

if [[ ${#names[@]} -eq 0 ]]; then
    source "$file"
else
    for name in "${names[@]}"; do
        # The file exports every secret, so source it in a subshell.
        value="$(source "$file"; printf '%s' "${!name-}")"
        if [[ -z "$value" ]]; then
            echo "with-secrets: $name is not set in $file" >&2
            exit 1
        fi
        export "$name=$value"
    done
fi

exec "$@"
