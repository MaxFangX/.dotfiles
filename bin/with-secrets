#!/usr/bin/env bash
set -euo pipefail

# Run a command with secrets from ~/env/sensitive.sh in its environment, or
# list their names:
#
#   with-secrets -o A,B <cmd> [args...]    only A and B
#   with-secrets -a <cmd> [args...]        every secret
#   with-secrets -l                        the names alone

file="$HOME/env/sensitive.sh"

usage() {
    echo "usage: with-secrets -o NAME[,NAME...] <cmd> [args...]" >&2
    echo "       with-secrets -a <cmd> [args...]" >&2
    echo "       with-secrets -l" >&2
    exit 2
}

case "${1:-}" in
    -l)
        [[ $# -eq 1 ]] || usage
        # Print the NAME of each `export NAME=value` line.
        sed -nE 's/^export ([A-Za-z_][A-Za-z0-9_]*)=.*/\1/p' "$file"
        exit
        ;;
    -a)
        [[ $# -ge 2 ]] || usage
        shift
        set +u
        source "$file"
        ;;
    -o)
        [[ $# -ge 3 && -n "$2" ]] || usage
        IFS=, read -ra names <<< "$2"
        shift 2
        for name in "${names[@]}"; do
            [[ $name =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || usage
            # The file exports every secret, so source it in a subshell.
            value="$(set +u; source "$file"; printf '%s' "${!name-}")"
            if [[ -z "$value" ]]; then
                echo "with-secrets: $name is not set in $file" >&2
                exit 1
            fi
            export "$name=$value"
        done
        ;;
    *)
        usage
        ;;
esac

exec "$@"
